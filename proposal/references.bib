% 仅用于演示 BibTeX 和引用格式的公开排版文献。
% 替换这些条目后，在正文中使用 \cite{文献键}。
% 字段用双层花括号保护机构名称或需要保持大小写的缩写。

@book{latex-book,
  author    = {Lamport, Leslie},
  title     = {{LaTeX}: A Document Preparation System},
  edition   = {2},
  address   = {Reading, MA},
  publisher = {Addison-Wesley},
  year      = {1994},
  isbn      = {9780201529838}
}

@book{texbook,
  author    = {Knuth, Donald E.},
  title     = {The {TeXbook}},
  address   = {Reading, MA},
  publisher = {Addison-Wesley},
  year      = {1984},
  isbn      = {0201134489}
}

@online{ctex-package,
  author    = {{CTEX.ORG}},
  title     = {{CTeX}: {LaTeX} classes and packages for Chinese typesetting},
  year      = {2026},
  url       = {https://ctan.org/pkg/ctex},
  urldate   = {2026-11-18}
}

