	\fancyhead[L]{\normalfont\songti\fontsize{10.5bp}{13bp}\selectfont\proposal@headerleft}%
	\fancyhead[R]{\normalfont\songti\fontsize{10.5bp}{13bp}\selectfont\proposal@headerright}%
	\renewcommand\headrulewidth{0.75bp}%
	\renewcommand\footrulewidth{0pt}%
	\ifproposal@pagenumbers
	\fancyfoot[C]{\normalfont\rmfamily\fontsize{10.5bp}{13bp}\selectfont\thepage}%
	\fi}
\fancypagestyle{proposal}{\proposal@pagefields}
\fancypagestyle{plain}{\proposal@pagefields}
\pagestyle{proposal}
\setlength\parindent{24bp}
\setlength\parskip{0pt}
\raggedbottom
\setlength\emergencystretch{1em}
% 原 Word 网格 15.6bp，正文 1.2 倍；PDF 连续行基线相距 18.72bp。
\renewcommand\normalsize{%
	\@setfontsize\normalsize{12bp}{18.72bp}%
	\setlength\abovedisplayskip{8bp}\setlength\belowdisplayskip{8bp}%
	\setlength\abovedisplayshortskip{4bp}\setlength\belowdisplayshortskip{4bp}}
\AtBeginDocument{\normalsize\songti}

% ----------------------------------------------------------------------------
% 06. 标题层级与章节编号
% ----------------------------------------------------------------------------
% 标题末尾点属于编号格式；一级/二级之间不强制换页。
\setcounter{secnumdepth}{4}
\setcounter{tocdepth}{4}
\ctexset{
	section={format=\normalfont\heiti\fontsize{15bp}{15.6bp}\selectfont,
		name={},number=\arabic{section},aftername={.\hspace{1.2bp}},
		beforeskip=7.8bp,afterskip=7.8bp,indent=0pt,afterindent=true},
	subsection={format=\normalfont\heiti\fontsize{14bp}{18.72bp}\selectfont,
		name={},number=\thesection.\arabic{subsection},
		numberformat=\fontsize{12bp}{18.72bp}\selectfont,
		aftername={.\hspace{2bp}},beforeskip=7.8bp,afterskip=7.8bp,
		indent=0pt,afterindent=true,runin=false},
	subsubsection={format=\normalfont\heiti\fontsize{12bp}{15.6bp}\selectfont,
		name={},number=\thesubsection.\arabic{subsubsection},
		aftername={.\hspace{0.5bp}},beforeskip=0pt,afterskip=0pt,
		indent=0pt,afterindent=true,runin=false},
	paragraph={format=\normalfont\heiti\fontsize{12bp}{24.18bp}\selectfont,
		name={},number=\thesubsubsection.\arabic{paragraph},
		aftername={.\hspace{6bp}},beforeskip=0pt,afterskip=0pt,
		indent=0pt,runin=false,afterindent=true}
}

