% ----------------------------------------------------------------------------
% 09. 参考文献（natbib / GB/T 7714）
% ----------------------------------------------------------------------------
% 参考文献不缩进：编号与续行均从正文左边界开始，编号后空3bp。
% thebibliography 自动生成参考文献 section；正文无需再写 \section{参考文献}。
\renewenvironment{thebibliography}[1]{%
	\section{\refname}%
	\normalfont\songti\fontsize{12bp}{15.6bp}\selectfont
	\list{\@biblabel{\the\c@NAT@ctr}}{%
		\global\c@NAT@ctr\z@
		\setlength\leftmargin{0pt}\setlength\rightmargin{0pt}%
		\setlength\labelwidth{0pt}\setlength\labelsep{0pt}%
		\setlength\itemindent{0pt}\setlength\listparindent{0pt}%
		\setlength\itemsep{0pt}\setlength\parsep{0pt}\setlength\topsep{0pt}%
		\renewcommand\makelabel[1]{##1\hspace{3bp}}}%
	\let\NAT@bibitem@first@sw\@firstoftwo
	\sloppy\clubpenalty4000\widowpenalty4000
}{\bibitem@fin\endlist\bibcleanup}

