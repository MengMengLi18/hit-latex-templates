% 默认固定使用随模板分发的开源字体，保证不同机器上的选择一致。
% strictfonts 只读取 fonts/local/ 中由使用者自行提供的字体。
\newcommand\proposal@requiredlocalfont[1]{%
  \IfFileExists{fonts/local/#1}{}{%
    \PackageError{hit-proposal}{Required font missing: fonts/local/#1}%
      {Provide the font in fonts/local/ or remove the strictfonts option.}}}
\ifproposal@strict
  \proposal@requiredlocalfont{simsun.ttc}
  \proposal@requiredlocalfont{simhei.ttf}
  \proposal@requiredlocalfont{times.ttf}
  \proposal@requiredlocalfont{timesbd.ttf}
  \proposal@requiredlocalfont{timesi.ttf}
  \proposal@requiredlocalfont{timesbi.ttf}
  \IfFileExists{fonts/local/kaiti.ttf}{\def\proposal@kaifile{kaiti.ttf}}{%
    \def\proposal@kaifile{simkai.ttf}%
    \proposal@requiredlocalfont{simkai.ttf}}
  \setCJKmainfont[Path=fonts/local/,FontIndex=0,AutoFakeBold=2]{simsun.ttc}
  \setCJKfamilyfont{zhsong}[Path=fonts/local/,FontIndex=0,AutoFakeBold=2]{simsun.ttc}
  \setCJKsansfont[Path=fonts/local/]{simhei.ttf}
  \setCJKfamilyfont{zhhei}[Path=fonts/local/]{simhei.ttf}
  \setCJKfamilyfont{zhkai}[Path=fonts/local/,AutoFakeBold=2]{\proposal@kaifile}
  \setmainfont[Path=fonts/local/,BoldFont=timesbd.ttf,ItalicFont=timesi.ttf,
    BoldItalicFont=timesbi.ttf]{times.ttf}
  \IfFileExists{fonts/local/cambria.ttc}{%
    \newfontfamily\proposal@captionlatin[Path=fonts/local/,FontIndex=0]{cambria.ttc}%
  }{\IfFileExists{fonts/local/cambria.ttf}{%
    \newfontfamily\proposal@captionlatin[Path=fonts/local/]{cambria.ttf}%
  }{\newcommand\proposal@captionlatin{\rmfamily}}}
\else
  \setCJKmainfont[Path=fonts/fandol/,Script=CustomDefault,
    BoldFont=FandolSong-Bold.otf]{FandolSong-Regular.otf}
  \setCJKfamilyfont{zhsong}[Path=fonts/fandol/,Script=CustomDefault,
    BoldFont=FandolSong-Bold.otf]{FandolSong-Regular.otf}
  \setCJKsansfont[Path=fonts/fandol/,Script=CustomDefault,
    BoldFont=FandolHei-Bold.otf]{FandolHei-Regular.otf}
  \setCJKfamilyfont{zhhei}[Path=fonts/fandol/,Script=CustomDefault,
    BoldFont=FandolHei-Bold.otf]{FandolHei-Regular.otf}
  \setCJKfamilyfont{zhkai}[Path=fonts/fandol/,Script=CustomDefault,
    AutoFakeBold=2]{FandolKai-Regular.otf}
  \setmainfont[Path=fonts/tex-gyre/,BoldFont=texgyretermes-bold.otf,
    ItalicFont=texgyretermes-italic.otf,
    BoldItalicFont=texgyretermes-bolditalic.otf]{texgyretermes-regular.otf}
  \newcommand\proposal@captionlatin{\rmfamily}
\fi
\providecommand\songti{\CJKfamily{zhsong}}
\providecommand\heiti{\CJKfamily{zhhei}}
\providecommand\kaishu{\CJKfamily{zhkai}}
\xeCJKsetup{CJKmath=true}

% 11907 x 16840 twips；边距 1418 twips。
\geometry{paperwidth=595.35bp,paperheight=842bp,
  left=70.9bp,right=70.9bp,top=70.9bp,bottom=70.9bp,
  headheight=16bp,headsep=14.8bp,footskip=21.3bp}
% 页眉右侧默认随 reporttype 更新；plain 与正文使用相同页眉页脚。
\newcommand\proposal@pagefields{%
  \fancyhf{}%
  \fancyhead[L]{\normalfont\songti\fontsize{10.5bp}{13bp}\selectfont\proposal@headerleft}%
  \fancyhead[R]{\normalfont\songti\fontsize{10.5bp}{13bp}\selectfont\proposal@headerright}%
  \renewcommand\headrulewidth{0.75bp}%
  \renewcommand\footrulewidth{0pt}%
  \ifproposal@pagenumbers
    \fancyfoot[C]{\normalfont\rmfamily\fontsize{10.5bp}{13bp}\selectfont\thepage}%
  \fi}
\fancypagestyle{proposal}{\proposal@pagefields}
\fancypagestyle{plain}{\proposal@pagefields}
\pagestyle{proposal}
\setlength\parindent{24bp}
\setlength\parskip{0pt}
\raggedbottom
\setlength\emergencystretch{1em}
% 正文网格基准 15.6bp，行距系数 1.2，连续行基线相距 18.72bp。
\renewcommand\normalsize{%
  \@setfontsize\normalsize{12bp}{18.72bp}%
  \setlength\abovedisplayskip{8bp}\setlength\belowdisplayskip{8bp}%
  \setlength\abovedisplayshortskip{4bp}\setlength\belowdisplayshortskip{4bp}}
\AtBeginDocument{\normalsize\songti}

% 标题末尾点属于编号格式；一级/二级之间不强制换页。
\setcounter{secnumdepth}{4}
\setcounter{tocdepth}{4}
\ctexset{
  section={format=\normalfont\heiti\fontsize{15bp}{15.6bp}\selectfont,
    name={},number=\arabic{section},aftername={.\hspace{1.2bp}},
    beforeskip=7.8bp,afterskip=7.8bp,indent=0pt,afterindent=true},
  subsection={format=\normalfont\heiti\fontsize{14bp}{18.72bp}\selectfont,
    name={},number=\thesection.\arabic{subsection},
    numberformat=\fontsize{12bp}{18.72bp}\selectfont,
    aftername={.\hspace{2bp}},beforeskip=7.8bp,afterskip=7.8bp,
    indent=0pt,afterindent=true,runin=false},
  subsubsection={format=\normalfont\heiti\fontsize{12bp}{15.6bp}\selectfont,
    name={},number=\thesubsection.\arabic{subsubsection},
    aftername={.\hspace{0.5bp}},beforeskip=0pt,afterskip=0pt,
    indent=0pt,afterindent=true,runin=false},
  paragraph={format=\normalfont\heiti\fontsize{12bp}{24.18bp}\selectfont,
    name={},number=\thesubsubsection.\arabic{paragraph},
    aftername={.\hspace{6bp}},beforeskip=0pt,afterskip=0pt,
    indent=0pt,runin=false,afterindent=true}
}
% 四级目录：宋体12bp，不沿用 LaTeX 默认的加粗一级条目。
\titlecontents{section}[52.6bp]
  {\normalfont\songti\fontsize{12bp}{18.72bp}\selectfont}
  {\contentslabel[\thecontentslabel.]{28.6bp}}{}
  {\titlerule*[3bp]{.}\contentspage}
\titlecontents{subsection}[73.6bp]
  {\normalfont\songti\fontsize{12bp}{18.72bp}\selectfont}
  {\contentslabel[\thecontentslabel.]{37.6bp}}{}
  {\titlerule*[3bp]{.}\contentspage}
\titlecontents{subsubsection}[84bp]
  {\normalfont\songti\fontsize{12bp}{18.72bp}\selectfont}
  {\contentslabel[\thecontentslabel.]{36bp}}{}
  {\titlerule*[3bp]{.}\contentspage}
\titlecontents{paragraph}[102bp]
  {\normalfont\songti\fontsize{12bp}{18.72bp}\selectfont}
  {\contentslabel[\thecontentslabel.]{42bp}}{}
  {\titlerule*[3bp]{.}\contentspage}
\newcommand\proposaltableofcontents{%
