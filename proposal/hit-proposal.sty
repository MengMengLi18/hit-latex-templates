% ----------------------------------------------------------------------------
% 03. 字体检测、中文字体与西文字体
% ----------------------------------------------------------------------------
% 只按带扩展名的字体文件检测，避免缺失的系统字体名触发 mktextfm。
% 优先使用 fonts/ 下的原字库，其次查找 TeX 可发现的同名字体文件。
% 默认使用随项目提供的开源字体；strictfonts 仍要求原 Word 字库。
\newcommand\proposal@withfontfile[3]{%
	\IfFileExists{fonts/#1}{\def\proposal@fontfile{fonts/#1}#2}{%
		\IfFontExistsTF{#1}{\def\proposal@fontfile{#1}#2}{#3}}}
\newcommand\proposal@fallback[2]{%
	\ifproposal@strict
	\PackageError{hit-proposal}{Original font missing: #1}{Install the original font, or remove strictfonts for a substitute preview.}%
	\else
	\PackageInfo{hit-proposal}{Original font #1 unavailable; using #2}%
	\fi}
\proposal@withfontfile{simsun.ttc}{%
	\setCJKmainfont[FontIndex=0,AutoFakeBold=2]{\proposal@fontfile}%
	\setCJKfamilyfont{zhsong}[FontIndex=0,AutoFakeBold=2]{\proposal@fontfile}%
}{%
	\proposal@fallback{SimSun}{bundled FandolSong}%
	% Fandol 没有 OpenType shaping 脚本；使用 fontspec 的可选默认脚本回退。
	\setCJKmainfont[Path=fonts/fandol/,Script=CustomDefault,
	BoldFont=FandolSong-Bold.otf]{FandolSong-Regular.otf}%
	\setCJKfamilyfont{zhsong}[Path=fonts/fandol/,Script=CustomDefault,
	BoldFont=FandolSong-Bold.otf]{FandolSong-Regular.otf}%
}
\proposal@withfontfile{simhei.ttf}{%
	\setCJKsansfont{\proposal@fontfile}%
	\setCJKfamilyfont{zhhei}{\proposal@fontfile}%
}{%
	\proposal@fallback{SimHei}{bundled FandolHei}%
	\setCJKsansfont[Path=fonts/fandol/,Script=CustomDefault,
	BoldFont=FandolHei-Bold.otf]{FandolHei-Regular.otf}%
	\setCJKfamilyfont{zhhei}[Path=fonts/fandol/,Script=CustomDefault,
	BoldFont=FandolHei-Bold.otf]{FandolHei-Regular.otf}%
}
\newcommand\proposal@setkai{%
	\setCJKfamilyfont{zhkai}[AutoFakeBold=2]{\proposal@fontfile}}
\proposal@withfontfile{kaiti.ttf}{\proposal@setkai}{%
	\proposal@withfontfile{simkai.ttf}{\proposal@setkai}{%
		\proposal@fallback{KaiTi / KaiTi_GB2312}{bundled FandolKai}%
		\setCJKfamilyfont{zhkai}[Path=fonts/fandol/,Script=CustomDefault,
		AutoFakeBold=2]{FandolKai-Regular.otf}%
	}%
}
% Times New Roman 的四种字面成套存在时才使用，避免粗体或斜体缺失。
\newcommand\proposal@iftimes[3]{%
	\IfFontExistsTF{#1times.ttf}{%
		\IfFontExistsTF{#1timesbd.ttf}{%
			\IfFontExistsTF{#1timesi.ttf}{%
				\IfFontExistsTF{#1timesbi.ttf}{#2}{#3}%
			}{#3}%
		}{#3}%
	}{#3}}
\newcommand\proposal@settimes[1]{%
	% 用 Path 单独指定目录，避免将 fonts/ 误识别为 NFSS 字族名。
	\setmainfont[Path=#1,BoldFont=timesbd.ttf,ItalicFont=timesi.ttf,
	BoldItalicFont=timesbi.ttf]{times.ttf}}
\proposal@iftimes{fonts/}{\proposal@settimes{fonts/}}{%
	\proposal@iftimes{}{\proposal@settimes{}}{%
		\proposal@fallback{Times New Roman}{bundled TeX Gyre Termes}%
		\setmainfont[Path=fonts/tex-gyre/,BoldFont=texgyretermes-bold.otf,
		ItalicFont=texgyretermes-italic.otf,
		BoldItalicFont=texgyretermes-bolditalic.otf]{texgyretermes-regular.otf}%
	}%
}
\providecommand\songti{\CJKfamily{zhsong}}
\providecommand\heiti{\CJKfamily{zhhei}}
\providecommand\kaishu{\CJKfamily{zhkai}}
\xeCJKsetup{CJKmath=true}

